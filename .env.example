# Credentials for the live test suite (tests marked `live`).
# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# Values already set in the environment take priority over this file.

# Token of the Notion integration the throwaway test database is shared with.
NOTION_LIVE_TOKEN=

# Data source ID of that database (not the database ID from its URL).
NOTION_LIVE_DATA_SOURCE_ID=

# Optional: a workspace member's user ID, to test writing a person property.
NOTION_LIVE_USER_ID=

# Optional: the verification token of a webhook subscription in Notion, for
# a manual end-to-end webhook test (see "Setting up webhooks" in README.md).
# The automated live suite does not need it.
NOTION_LIVE_WEBHOOK_VERIFICATION_TOKEN=
